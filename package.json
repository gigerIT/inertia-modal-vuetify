{
  "name": "@gigerit/inertia-modal-vuetify",
  "version": "3.0.0",
  "description": "Vuetify-styled drop-in replacement for @inertiaui/modal-vue",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gigerIT/inertia-modal-vuetify.git"
  },
  "main": "./dist/inertia-modal-vuetify.js",
  "types": "./src/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./dist/inertia-modal-vuetify.js"
    },
    "./src": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "dev": "vite serve example",
    "build": "vite build",
    "build:example": "vite build example",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^4.2.0",
    "@inertiajs/vue3": "^3.0.0"
  },
  "dependencies": {
    "@inertiaui/modal-vue": "^3.1.2",
    "@inertiaui/vanilla": "^1.5.0"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^3.9.1",
    "@mdi/font": "^7.4.47",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vuetify": "^4.3.0"
  },
  "keywords": [
    "inertia",
    "inertiajs",
    "modal",
    "vuetify",
    "vue"
  ],
  "author": "",
  "license": "MIT"
}
